# Default live (NASA POWER); TD_DATA_MODE=demo schaltet auf synthetische Demo-Daten.
TD_DATA_MODE=live
TD_CACHE_DIR=../../data/cache
TD_CACHE_TTL_SECONDS=86400
TD_POWER_TIMEOUT_SECONDS=15
TD_ALLOWED_ORIGINS=["http://localhost:5173"]
# Optional: letztes POWER-Jahr im Live-Modus (leer = letztes vollständiges Kalenderjahr)
# TD_POWER_END_YEAR=2025
